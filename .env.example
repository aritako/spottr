# Copy to .env and fill in. Never commit .env.

# Required for the coach engine (OpenAI Responses API + embeddings)
OPENAI_API_KEY=sk-your-key-here

# Used when running pytest/alembic from your host machine.
# Inside Docker, docker-compose.yaml sets DATABASE_URL to the "db" host instead.
DATABASE_URL=postgresql+psycopg://coach:coach@localhost:5432/coach

# Isolated database for the real-DB test suite (docker compose `test-db` service).
# From inside Docker use: postgresql+psycopg://coach:coach@test-db:5432/coach_test
TEST_DATABASE_URL=postgresql+psycopg://coach:coach@localhost:5433/coach_test

# Used for generating embeddings for the coach RAG engine.
EMBEDDING_MODEL=text-embedding-3-small
